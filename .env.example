# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (for WP-02)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT Configuration (for WP-03)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# MFA Configuration
TOTP_ENCRYPTION_KEY=

# Gateway Mode: MOCK or DARAJA
PAYMENT_GATEWAY_MODE=MOCK

# Webhook Security Token
MPESA_CALLBACK_TOKEN=your_secure_random_token

# Daraja Sandbox Credentials
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_key
MPESA_CONSUMER_SECRET=your_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/deposit/callback?token=your_secure_random_token

# Email Configuration (for notifications)
EMAIL_SENDER_NAME=SkiesPro
EMAIL_SENDER_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Price Feed Configuration
BINANCE_API_KEY=
STALE_PRICE_THRESHOLD_SEC=30
PRICE_VALIDATION_THRESHOLD_PCT=0.05
USE_MOCK_PRICES=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Wallet & Payments Configuration
MIN_DEPOSIT_KES=500
MIN_WITHDRAWAL_KES=1500
WITHDRAWAL_FEE_PERCENT=2
BASE_CURRENCY=KES

# Admin Configuration (WP-15 & WP-20)
ADMIN_RATE_LIMIT_PER_MIN=300
ADMIN_MFA_REQUIRED=true
ADMIN_FOUR_EYES_THRESHOLD_USD=500
ADMIN_SUPER_ADMIN_EMAIL=its.phestone@gmail.com
SUPER_ADMIN_EMAIL=its.phestone@gmail.com
SUPER_ADMIN_PASSWORD=change_me_in_production
VITE_ADMIN_DEFAULT_ROLE=super_admin
VITE_ADMIN_FOUR_EYES_THRESHOLD_USD=500

# Logging
LOG_LEVEL=info

# Monitoring Platform (for WP-03)
MONITORING_PLATFORM=prometheus
MONITORING_URL=
MONITORING_API_KEY=

# Log Aggregation Platform (for WP-03)
LOG_PLATFORM=loki
LOG_URL=
LOG_API_KEY=

# Message Broker (for WP-03)
MESSAGE_BROKER=rabbitmq
RABBITMQ_URL=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Cache state is process-local and is not shared across backend instances.

# Container Registry (for WP-03)
CONTAINER_REGISTRY=ghcr.io
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Secrets Manager (for WP-03)
SECRETS_MANAGER=vault
VAULT_URL=
VAULT_TOKEN=

# WebSocket Configuration (for WP-09)
WS_PATH=/ws/v1
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=8
WS_INBOUND_RATE_LIMIT_PER_MIN=10

# Pricing Configuration
ENABLE_PRICE_FEED=false

# Trading Configuration (for WP-10)
MAX_STAKE_AMOUNT=50000
MIN_STAKE_AMOUNT=100
MAX_ASSET_EXPOSURE=1300000
MAX_ORACLE_GAP_MS=10000
ENABLE_SETTLEMENT_WORKER=false

# Demo Trading Configuration (WP-21; keep disabled until migration 033 is verified)
DEMO_ENABLED=false
DEMO_INITIAL_BALANCE_KES=100000
DEMO_TICK_RETENTION_DAYS=30
